{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gift card for {{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600&family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: Nunito, sans-serif; background: #FFF8DC; color: #1C2B6E; text-align: center; padding: 4rem 1.5rem; margin: 0; }
      .card { background: #fff; border-radius: 20px; max-width: 420px; margin: 0 auto; padding: 2.5rem; box-shadow: 0 12px 32px rgba(28,43,110,.1); }
      h1 { font-family: Fredoka, sans-serif; }
      .amount { font-size: 2.5rem; font-weight: 700; color: #2547C4; }
      .code { background: #FFF8DC; border-radius: 10px; padding: 1rem; font-size: 1.25rem; letter-spacing: .12em; margin: 1.5rem 0; }
      a.btn { display: inline-block; background: #2547C4; color: #fff; text-decoration: none; padding: .9rem 2rem; border-radius: 999px; font-weight: 700; }
    </style>
  </head>
  <body>
    <div class="card">
      <div style="font-size:3rem;">🧸</div>
      <h1>{{ shop.name }} gift card</h1>
      <p class="amount">{{ gift_card.initial_value | money }}</p>
      {% if gift_card.enabled == false or gift_card.expired %}
        <p>This gift card is no longer valid.</p>
      {% endif %}
      <div class="code">{{ gift_card.code | format_code }}</div>
      <a class="btn" href="{{ shop.url }}">Start shopping</a>
    </div>
  </body>
</html>
