<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="64x64" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- assign brand = settings.brand_name | default: shop.name -%}
      {%- unless page_title contains brand %} &ndash; {{ brand }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <meta property="og:site_name" content="{{ settings.brand_name | default: shop.name }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    {% style %}
      :root {
        --color-ink: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
        --color-accent: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
        --color-butter: {{ settings.color_butter.red }}, {{ settings.color_butter.green }}, {{ settings.color_butter.blue }};
        --color-bg: {{ settings.color_bg.red }}, {{ settings.color_bg.green }}, {{ settings.color_bg.blue }};
        --color-bg-soft: {{ settings.color_bg_soft.red }}, {{ settings.color_bg_soft.green }}, {{ settings.color_bg_soft.blue }};
        --color-sale: {{ settings.color_sale.red }}, {{ settings.color_sale.green }}, {{ settings.color_sale.blue }};
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script>
      window.SQ = {
        moneyFormat: {{ shop.money_format | json }},
        cartUrl: {{ routes.cart_url | json }}
      };
    </script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <div class="ar" data-ar aria-hidden="true">
      <video class="ar__video" data-ar-video autoplay playsinline muted></video>
      <div class="ar__stage" data-ar-stage>
        <div class="ar__butter" data-ar-butter>
          <div class="squeeze__body" data-squeeze-body>
            <img data-ar-img src="{{ 'butter-03.png' | asset_url }}" alt="" width="560" height="540" draggable="false">
            <div class="squeeze__dimples" data-dimples></div>
          </div>
        </div>
      </div>
      <div class="ar__msg" data-ar-msg></div>
      <button type="button" class="ar__close" data-ar-close aria-label="Close camera">&times;</button>
      <div class="ar__bar"><span>Drag to move · pinch to resize · tap to squeeze</span></div>
    </div>
  </body>
</html>
