[
  {
    "name": "theme_info",
    "theme_name": "The Squishy Store",
    "theme_version": "1.0.0",
    "theme_author": "The Squishy Store",
    "theme_documentation_url": "https://github.com/MarshHAP/buttersquishy",
    "theme_support_url": "https://github.com/MarshHAP/buttersquishy"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "The Squishy Store",
        "info": "Shown in the header, footer, and page titles."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text / ink",
        "default": "#1C2B6E"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#2547C4"
      },
      {
        "type": "color",
        "id": "color_butter",
        "label": "Butter / highlight",
        "default": "#FFD447"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_bg_soft",
        "label": "Soft background",
        "default": "#FFF8DC"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / savings",
        "default": "#E5462B"
      }
    ]
  },
  {
    "name": "Buy box & bundle offer",
    "settings": [
      {
        "type": "paragraph",
        "content": "Single price comes from the product. Enter tier prices in pence (1299 = £12.99) and create the matching automatic discounts — see store-setup/README.md."
      },
      {
        "type": "number",
        "id": "bundle_tier2_price",
        "label": "Price for Buy Two (pence)",
        "default": 1299
      },
      {
        "type": "number",
        "id": "bundle_tier3_price",
        "label": "Price for Buy Three (pence)",
        "default": 1499
      },
      {
        "type": "text",
        "id": "tier1_label",
        "label": "Tier 1 label",
        "default": "Buy One"
      },
      {
        "type": "text",
        "id": "tier2_label",
        "label": "Tier 2 label",
        "default": "Buy Two"
      },
      {
        "type": "text",
        "id": "tier3_label",
        "label": "Tier 3 label",
        "default": "Buy Three"
      },
      {
        "type": "text",
        "id": "tier2_badge",
        "label": "Tier 2 badge",
        "default": "MOST POPULAR"
      },
      {
        "type": "text",
        "id": "tier3_badge",
        "label": "Tier 3 badge",
        "default": "BEST VALUE"
      },
      {
        "type": "select",
        "id": "default_tier",
        "label": "Pre-selected tier",
        "options": [
          {
            "value": "1",
            "label": "Buy One"
          },
          {
            "value": "2",
            "label": "Buy Two"
          },
          {
            "value": "3",
            "label": "Buy Three"
          }
        ],
        "default": "2"
      },
      {
        "type": "range",
        "id": "ship_lead_days",
        "label": "Arrives-by lead time (days)",
        "min": 2,
        "max": 10,
        "step": 1,
        "default": 5
      },
      {
        "type": "text",
        "id": "reviews_text",
        "label": "Rating text",
        "default": "Rated 4.9 ‘Excellent’"
      },
      {
        "type": "text",
        "id": "reviews_count",
        "label": "Review count text",
        "default": "800+ Reviews"
      },
      {
        "type": "text",
        "id": "guarantee_text",
        "label": "Guarantee text",
        "default": "30 Day Money Back Guarantee"
      }
