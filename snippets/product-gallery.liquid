{%- comment -%}
  Product gallery: vertical thumbnail rail · main image · column of feature tiles.
  Accepts: product, tiles (pre-rendered HTML for the tile column, optional)
{%- endcomment -%}
<div class="gallery {% if tiles != blank %}gallery--with-tiles{% endif %}">
  {%- if product.images.size > 1 -%}
    <div class="gallery__thumbs" data-gallery-thumbs>
      {%- for image in product.images -%}
        <button type="button" class="gallery__thumb {% if forloop.first %}is-active{% endif %}" data-gallery-thumb data-full="{{ image | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}">
          <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy" width="90" height="90">
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="gallery__main" data-gallery-main>
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 900 }}"
        srcset="{{ product.featured_image | image_url: width: 450 }} 450w, {{ product.featured_image | image_url: width: 900 }} 900w, {{ product.featured_image | image_url: width: 1400 }} 1400w"
        sizes="(max-width: 989px) 100vw, 40vw"
        alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="eager" fetchpriority="high" width="1254" height="1254">
    {%- else -%}
      {% render 'butter-image', index: 1, width: 600 %}
    {%- endif -%}
  </div>

  {%- if tiles != blank -%}
    <div class="gallery__tiles">{{ tiles }}</div>
  {%- endif -%}
</div>
