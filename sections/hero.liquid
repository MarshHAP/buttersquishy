{%- assign slide_count = 0 -%}
{%- if section.settings.image != blank -%}{%- assign slide_count = slide_count | plus: 1 -%}{%- endif -%}
{%- if section.settings.image_2 != blank -%}{%- assign slide_count = slide_count | plus: 1 -%}{%- endif -%}
{%- if section.settings.image_3 != blank -%}{%- assign slide_count = slide_count | plus: 1 -%}{%- endif -%}
{%- if section.settings.image_4 != blank -%}{%- assign slide_count = slide_count | plus: 1 -%}{%- endif -%}

<div class="hero {% if slide_count > 0 %}hero--has-image{% endif %}">
  {%- if slide_count > 0 -%}
    <div class="hero__image" {% if slide_count > 1 %}data-hero-slideshow data-interval="{{ section.settings.interval | default: 5 }}"{% endif %}>
      {%- assign rendered = 0 -%}
      {%- for i in (1..4) -%}
        {%- case i -%}
          {%- when 1 -%}{%- assign slide_image = section.settings.image -%}
          {%- when 2 -%}{%- assign slide_image = section.settings.image_2 -%}
          {%- when 3 -%}{%- assign slide_image = section.settings.image_3 -%}
          {%- when 4 -%}{%- assign slide_image = section.settings.image_4 -%}
        {%- endcase -%}
        {%- if slide_image != blank -%}
          {%- assign rendered = rendered | plus: 1 -%}
          <img
            class="hero__slide {% if rendered == 1 %}is-active{% endif %}"
            src="{{ slide_image | image_url: width: 1600 }}"
            srcset="{{ slide_image | image_url: width: 600 }} 600w, {{ slide_image | image_url: width: 1000 }} 1000w, {{ slide_image | image_url: width: 1600 }} 1600w, {{ slide_image | image_url: width: 2200 }} 2200w"
            sizes="100vw"
            alt="{{ slide_image.alt | default: section.settings.heading | escape }}"
            {% if rendered == 1 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
            width="2000" height="1100">
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="hero__overlay"></div>
  {%- else -%}
    <span class="hero__blob" style="top:12%;left:8%;">🧸</span>
    <span class="hero__blob" style="top:58%;left:14%;font-size:3.6rem;animation-delay:1.2s;">🍋</span>
    <span class="hero__blob" style="top:18%;right:10%;font-size:4.4rem;animation-delay:2s;">☁️</span>
    <span class="hero__blob" style="top:62%;right:16%;font-size:3.8rem;animation-delay:0.6s;">🐸</span>
  {%- endif -%}

  <div class="hero__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero__sub">{{ section.settings.subheading }}</p>
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/products/squishy' }}" class="btn btn--large">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link | default: '#bundle' }}" class="btn btn--large btn--outline">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="trust-strip">
  <span>⭐️⭐️⭐️⭐️⭐️ Loved by 2,000+ squeezers</span>
  <span>🚚 Tracked shipping</span>
  <span>🛡 30-day guarantee</span>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Background image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Background image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Background image 4" },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per photo",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The original slow-rise stress squeezie" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Squeeze the Stress Away" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meet Squishy™ — the ultra-soft, slow-rise squeezie that melts in your hand and bounces right back, every single time."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
