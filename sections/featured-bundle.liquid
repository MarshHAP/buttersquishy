{%- assign product = all_products[section.settings.product] -%}

<div class="section" id="shop">
  <div class="page-width">
    <div class="section__heading animate-in">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    {%- if product != blank and product.variants.size > 0 -%}
      <div class="product-grid">
        <div class="animate-in">
          {% render 'product-gallery', product: product %}
        </div>
        <div class="product-info animate-in">
          <div class="product-info__stars">★★★★★ <span>4.9 — 2,000+ happy squeezers</span></div>
          {% render 'bundle-buy-box', product: product %}
        </div>
      </div>
    {%- else -%}
      <p style="text-align:center;">Select a product for this section in the theme editor.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured bundle",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix & match — 2 for £16.99 · 3 for £19.99" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Squishy Bundle" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Fifteen adorable squishies to choose from. Grab any two for £16.99 or any three for £19.99 — the discount applies automatically at checkout."
    }
  ],
  "presets": [{ "name": "Featured bundle" }]
}
{% endschema %}
