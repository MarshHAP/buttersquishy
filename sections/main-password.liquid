<div class="hero">
  <span class="hero__blob" style="top:15%;left:8%;width:14rem;">{% render 'butter-image', index: 1, width: 400 %}</span>
  <span class="hero__blob" style="top:20%;right:10%;width:11rem;animation-delay:1.5s;--blob-tilt:-16deg;">{% render 'butter-image', index: 8, width: 300 %}</span>
  <div class="hero__inner page-width">
    <span class="eyebrow">Something squishy is coming</span>
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ settings.brand_name | default: shop.name }}" width="480" height="480" style="width:min(60vw,24rem);height:auto;display:block;margin:0 auto 2rem;">
    <p class="hero__sub">{{ shop.description | default: 'The slow-rise stress squeezies you won’t be able to put down. Opening soon — join the list to be first in line.' }}</p>

    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      {%- if form.posted_successfully? -%}
        <p style="font-weight:600;color:#1d9e42;">🧸 You're on the list!</p>
      {%- else -%}
        <div class="newsletter-form" style="max-width:42rem;margin:0 auto;">
          <input type="email" name="contact[email]" placeholder="Your email" required aria-label="Email address" style="border-color:rgba(var(--color-ink),0.25);background:#fff;color:rgb(var(--color-ink));">
          <button type="submit" class="btn">Notify me</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <p style="margin-top:3.2rem;font-size:1.3rem;">
      <a href="#" onclick="document.getElementById('password-modal').style.display='block';return false;">Store owner? Log in here</a>
    </p>
    <div id="password-modal" style="display:none;max-width:42rem;margin:1.6rem auto 0;">
      {%- form 'storefront_password' -%}
        <div class="newsletter-form">
          <input type="password" name="password" placeholder="Password" aria-label="Password" style="border-color:rgba(var(--color-ink),0.25);background:#fff;color:rgb(var(--color-ink));">
          <button type="submit" class="btn">Enter</button>
        </div>
        {{ form.errors | default_errors }}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
