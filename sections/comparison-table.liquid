<div class="section">
  <div class="page-width">
    <div class="section__heading animate-in">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="comparison animate-in">
      <table>
        <thead>
          <tr>
            <th></th>
            <th class="comparison__us">{{ section.settings.us_label }}</th>
            <th>{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td><span class="{% if block.settings.us %}yes{% else %}no{% endif %}">{% if block.settings.us %}✔{% else %}✕{% endif %}</span></td>
              <td><span class="{% if block.settings.them %}yes{% else %}no{% endif %}">{% if block.settings.them %}✔{% else %}✕{% endif %}</span></td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Butter Squishy?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Not all squishies are created equal." },
    { "type": "text", "id": "us_label", "label": "Our column label", "default": "The Squishy Store" },
    { "type": "text", "id": "them_label", "label": "Their column label", "default": "Other squishies" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Ultra-realistic butter look" },
        { "type": "checkbox", "id": "us", "label": "We have it", "default": true },
        { "type": "checkbox", "id": "them", "label": "They have it", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Ultra-realistic butter look", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "Slow-rebound foam that returns to shape", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "Non-toxic, kid-safe material", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "2 for £12.99 · 3 for £14.99 bundles", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "30-day money-back guarantee", "us": true, "them": false } },
        { "type": "row", "settings": { "feature": "Stiff, rubbery or tears within a week", "us": false, "them": true } }
      ]
    }
  ]
}
{% endschema %}
