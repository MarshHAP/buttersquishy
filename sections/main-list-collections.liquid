<div class="section">
  <div class="page-width">
    <div class="section__heading"><h1>Collections</h1></div>
    <div class="product-card-grid">
      {%- for collection in collections -%}
        <a class="product-card" href="{{ collection.url }}">
          <div class="product-card__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 700 }}" alt="{{ collection.title | escape }}" loading="lazy" width="700" height="700">
            {%- else -%}
              <span aria-hidden="true">🧸</span>
            {%- endif -%}
          </div>
          <div class="product-card__title">{{ collection.title }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
