<div class="section">
  <div class="page-width">
    <div class="search-page" style="padding-bottom:3rem;">
      <h1>Search</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:48rem;margin:0 auto;display:flex;gap:0.8rem;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search our store" aria-label="Search" style="flex:1;padding:1.3rem 1.6rem;border:0.1rem solid rgba(var(--color-ink),0.2);border-radius:999rem;font-family:var(--font-body);font-size:1.5rem;">
        <button type="submit" class="btn">Search</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results.size > 0 -%}
          <div class="product-card-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item %}
              {%- else -%}
                <a class="product-card" href="{{ item.url }}"><div class="product-card__title">{{ item.title }}</div></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p style="text-align:center;">No results for “{{ search.terms | escape }}”.</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
