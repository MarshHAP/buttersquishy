{%- assign product = all_products[section.settings.product] -%}

{%- capture tiles -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tile' -%}
      <div class="tile" {{ block.shopify_attributes }}>
        <span class="tile__icon">{% render 'icon', name: block.settings.icon %}</span>
        <span class="tile__label">{{ block.settings.label }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div class="section" id="shop">
  <div class="page-width">
    <div class="section__heading animate-in">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    {%- if product != blank -%}
      <div class="product-grid">
        <div class="product-grid__media animate-in">
          {% render 'product-gallery', product: product, tiles: tiles %}
        </div>
        <div class="product-grid__buy animate-in">
          {% render 'buy-box', product: product, tagline: section.settings.tagline, heading_tag: 'h3' %}
          {% render 'squeeze-me', show_squeeze: section.settings.show_squeeze, show_see: section.settings.show_see, butter: section.settings.play_butter %}
        </div>
      </div>
    {%- else -%}
      <p style="text-align:center;">Select a product for this section in the theme editor.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "header", "content": "Squeeze Me / See Me" },
    { "type": "checkbox", "id": "show_squeeze", "label": "Show “Squeeze Me” panel", "default": true },
    { "type": "checkbox", "id": "show_see", "label": "Show “See Me” camera panel", "default": true },
    { "type": "range", "id": "play_butter", "label": "Which butter cutout (1–10)", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "1 for £9.99 · 2 for £12.99 · 3 for £19.99" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Butter Squishy" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "An ultra-realistic stick of butter that squishes, stretches and slowly rises back. Grab one for your desk — or three for the whole office." },
    { "type": "text", "id": "tagline", "label": "Tagline (under the product title)", "default": "The prank that doubles as the most satisfying stress toy on your desk." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Feature tile",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "hand", "label": "Hand" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "gift", "label": "Gift" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "bolt", "label": "Bolt" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Ultra-Realistic Butter Look" }
      ]
    }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
