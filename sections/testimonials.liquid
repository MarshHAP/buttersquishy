<div class="section {% if section.settings.soft_bg %}section--soft{% endif %}">
  <div class="page-width">
    <div class="section__heading animate-in">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="testimonials">
      {%- for block in section.blocks -%}
        <div class="testimonial animate-in" {{ block.shopify_attributes }}>
          <div class="testimonial__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
          </div>
          <p class="testimonial__text">“{{ block.settings.quote }}”</p>
          <p class="testimonial__author">{{ block.settings.author }} <span>{{ block.settings.detail }}</span></p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Squeezers (and Pranksters)" },
    { "type": "text", "id": "text", "label": "Text", "default": "Here's what our customers are saying." },
    { "type": "checkbox", "id": "soft_bg", "label": "Soft background", "default": false }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Keeps one on my desk for stressful calls. The slow rise is weirdly satisfying — best £10 I've spent this year." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sophie M." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer — Butter Bear" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{"type": "testimonial", "settings": {"stars": 5, "quote": "Left it in the office fridge on Monday. By Wednesday three people had tried to butter their toast with it. Now it lives on my desk for stressful calls.", "author": "Sophie M.", "detail": "Verified buyer — Buy Two"}}, {"type": "testimonial", "settings": {"stars": 5, "quote": "Bought three for stocking fillers. The slow rise is weirdly satisfying and they look SO real — my dad genuinely put one in the butter dish.", "author": "Daniel K.", "detail": "Verified buyer — Buy Three"}}, {"type": "testimonial", "settings": {"stars": 5, "quote": "So much softer than the cheap fidget toys we’ve had. My son takes his to school in his pencil case and it still springs back like new.", "author": "Priya S.", "detail": "Verified buyer — Buy One"}}]
    }
  ]
}
{% endschema %}
