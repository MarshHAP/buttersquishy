<div class="section {% if section.settings.soft_bg %}section--soft{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__heading animate-in"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="icon-bar">
      {%- for block in section.blocks -%}
        <div class="icon-bar__item animate-in" {{ block.shopify_attributes }}>
          <div class="icon-bar__icon">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H4l2.5-2.5A8 8 0 1 1 21 12z"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5h14v11H1z"/><path d="M15 9h4l4 4v3h-8z"/><circle cx="6" cy="18.5" r="1.8"/><circle cx="18" cy="18.5" r="1.8"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-4 0-7 2.7-7 6.5 0 4.5 4.5 8.5 7 11.5 2.5-3 7-7 7-11.5C19 5.7 16 3 12 3z"/><path d="M9.5 9.5a2.5 2.5 0 0 1 5 0"/></svg>
            {%- endcase -%}
          </div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon bar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop With Total Peace of Mind" },
    { "type": "checkbox", "id": "soft_bg", "label": "Soft background", "default": true }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "chat", "label": "Chat" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "30-Day Guarantee" },
        { "type": "text", "id": "text", "label": "Text", "default": "Not squishy enough? Full refund, no questions asked." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "shield", "heading": "30-Day Guarantee", "text": "Not squishy enough? Full refund, no questions asked." } },
        { "type": "item", "settings": { "icon": "chat", "heading": "24/7 Customer Care", "text": "Real humans, ready to help any time." } },
        { "type": "item", "settings": { "icon": "truck", "heading": "Trackable Shipping", "text": "Follow your squishy all the way to your door." } },
        { "type": "item", "settings": { "icon": "heart", "heading": "Safe, Non-Toxic Foam", "text": "Soft, durable and made for ages 3+." } }
      ]
    }
  ]
}
{% endschema %}
