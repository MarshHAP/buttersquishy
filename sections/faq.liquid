<div class="section" id="faq">
  <div class="page-width">
    <div class="section__heading animate-in">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="faq animate-in">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does the bundle pricing work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>One squishy is £9.99. Add any two to your basket and you pay £12.99; add any three and you pay just £14.99. Mix and match any styles — the discount applies automatically at checkout, no code needed.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{"type": "question", "settings": {"question": "How does the bundle pricing work?", "answer": "<p>One Butter Squishy is £9.99. Choose “Buy Two” for £12.99 or “Buy Three” for £14.99 — the discount applies automatically at checkout, no code needed.</p>"}}, {"type": "question", "settings": {"question": "Is it real butter?", "answer": "<p>Nope! It’s a soft, slow-rebound foam squishy that looks exactly like a 4 oz stick of salted butter. Leave it on the counter or in the fridge and watch people try to use it.</p>"}}, {"type": "question", "settings": {"question": "What does it feel like?", "answer": "<p>Soft and squishy with a slow rise — squeeze it, stretch it or poke it and it slowly returns to shape over a few seconds. Not stiff or rubbery like cheaper fidget toys.</p>"}}, {"type": "question", "settings": {"question": "What age is it suitable for?", "answer": "<p>Great for kids, teens and adults as a calming sensory tool. Ages 3+ with supervision. Non-toxic and phthalate-free.</p>"}}, {"type": "question", "settings": {"question": "Will it lose its squish?", "answer": "<p>Unlike slime it won’t dry out or make a mess. Squeeze it again and again without losing its shape. Keep it away from sharp objects and direct sunlight.</p>"}}, {"type": "question", "settings": {"question": "What if I don’t love it?", "answer": "<p>Every order is covered by our 30-day money-back guarantee. If you’re not happy, we’ll refund you in full — no questions asked.</p>"}}]
    }
  ]
}
{% endschema %}
