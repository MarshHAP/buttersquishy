{%- assign product = all_products[section.settings.product] -%}
{%- assign use_product = false -%}
{%- if section.settings.source == 'product' and product != blank and product.variants.size > 0 -%}{%- assign use_product = true -%}{%- endif -%}

<div class="parade" aria-hidden="true">
  <a class="parade__link" href="{% if product != blank %}{{ product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}#buy" tabindex="-1">
    <div class="parade__track" style="--parade-duration: {{ section.settings.speed }}s;">
      {%- for copy in (1..2) -%}
        <div class="parade__group">
          {%- if use_product -%}
            {%- for variant in product.variants -%}
              <span class="parade__pet">
                {%- if variant.featured_image -%}
                  <img src="{{ variant.featured_image | image_url: width: 300 }}" alt="" loading="lazy" width="150" height="150">
                {%- else -%}
                  {% render 'butter-image', index: forloop.index, width: 300 %}
                {%- endif -%}
              </span>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..10) -%}
              <span class="parade__pet">{% render 'butter-image', index: i, width: 300 %}</span>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </a>
</div>

{% schema %}
{
  "name": "Squish parade",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Images",
      "options": [
        { "value": "butters", "label": "Butter squishy cutouts" },
        { "value": "product", "label": "Product variant photos" }
      ],
      "default": "butters"
    },
    { "type": "product", "id": "product", "label": "Product (link target / variant photos)" },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (seconds per loop)",
      "min": 20,
      "max": 90,
      "step": 5,
      "default": 45
    }
  ],
  "presets": [{ "name": "Squish parade" }]
}
{% endschema %}
