<div class="section">
  <div class="page-width">
    <div class="section__heading"><h1>{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      <div class="product-card-grid">
        {%- for article in blog.articles -%}
          <a class="product-card" href="{{ article.url }}">
            <div class="product-card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy" width="700" height="700">
              {%- else -%}
                <span aria-hidden="true">📰</span>
              {%- endif -%}
            </div>
            <div class="product-card__title">{{ article.title }}</div>
            <div class="product-card__price">{{ article.published_at | date: '%d %b %Y' }}</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
